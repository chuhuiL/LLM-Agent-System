# Application
APP_NAME="Clinical Documentation Platform"
APP_VERSION="0.1.0"
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://clinical_user:clinical_pass@localhost:5432/clinical_db
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.3

# FHIR
FHIR_SERVER_URL=http://hapi.fhir.org/baseR4
FHIR_CLIENT_ID=your-client-id
FHIR_CLIENT_SECRET=your-client-secret

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Vector Database
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=medical_knowledge

# Audio Processing
MAX_AUDIO_SIZE_MB=100
SUPPORTED_AUDIO_FORMATS=mp3,wav,m4a,ogg

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
